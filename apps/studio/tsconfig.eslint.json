{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2024",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.eslint.tsbuildinfo",
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "*.config.*",
    "*.js",
    "*.ts"
  ]
}
