{
  "name": "@transcendence/back",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --loader:.json=copy --packages=external --platform=node --format=esm --outfile=build/index.js",
    "build:seed": "esbuild scripts/seedDb.prod.ts --bundle --loader:.json=copy --packages=external --platform=node --format=esm --outfile=build/seedDb.prod.js",
    "check": "prettier --check . && eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx scripts/seedDb.dev.ts",
    "db:studio": "prisma studio --url $(cat .env | grep DATABASE_URL= | cut -d= -f2- )",
    "dev": "tsx watch src/index.ts",
    "fix": "prettier --write . && eslint --fix .",
    "start": "node build/index.js"
  },
  "prettier": "@transcendence/prettier-config",
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.1.0",
    "@fastify/rate-limit": "11.0.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "fastify-plugin": "6.0.0",
    "pg": "8.21.0",
    "prisma": "7.8.0"
  },
  "devDependencies": {
    "@transcendence/eslint-config": "workspace:*",
    "@transcendence/prettier-config": "workspace:*",
    "@types/node": "24.12.3",
    "@types/pg": "8.20.0",
    "esbuild": "0.28.0",
    "tsx": "4.22.3"
  }
}
