generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ARTIST
  MODERATOR
  GUEST
}

enum Key {
  A_key
  A_sharp_key
  B_flat_key
  B_key
  C_key
  C_sharp_key
  D_flat_key
  D_key
  D_sharp_key
  E_flat_key
  E_key
  F_key
  F_sharp_key
  G_flat_key
  G_key
  G_sharp_key
  A_flat_key
}

enum Mode {
  MAJOR
  MINOR
}

enum ProjectType {
  MIX
  PRODUCE
  RECORD
}

enum Family {
  KICK
  SNARE
  CLAP
  HAT
  TOM
  PERC
  CYMBAL
  BASS
  SYNTH
  LEAD
  PAD
  KEYS
  PLUCK
  STRINGS
  BRASS
  VOCAL
  FX
  AMBIENCE
}

enum OwnerType {
  PLATEFORM
  USER
}

enum VisibilityType {
  PRIVATE
  SHARED
  PUBLIC
}

enum SampleKind {
  ONE_SHOT
  LOOP
}

model Owner {
  id       String          @id @default(uuid())
  type     OwnerType
  user     User?
  samples  Sample[]
  projects StudioProject[]
  tracks   Track[]
}

model User {
  id                         String                    @id @default(uuid())
  email                      String                    @unique
  password                   String
  firstname                  String
  lastname                   String
  avatarUpdatedAt            DateTime?
  location                   String?
  bio                        String?
  handle                     String                    @unique
  artistName                 String                    @unique
  role                       Role
  links                      Json?
  owner                      Owner                     @relation(fields: [ownerId], references: [id])
  ownerId                    String                    @unique
  followedBy                 User[]                    @relation("UserFollows")
  following                  User[]                    @relation("UserFollows")
  sessions                   Session[]
  conversationParticipations ConversationParticipant[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  trackLikes                 TrackLike[]
}

model Sample {
  id         String          @id @default(uuid())
  owner      Owner           @relation(fields: [ownerId], references: [id])
  name       String
  ownerId    String
  family     Family?
  kind       SampleKind?
  bpm        Int?
  key        Key?
  mode       Mode?
  visibility VisibilityType
  url        String
  duration   Float
  bytes      Int
  projects   StudioProject[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Track {
  id          String         @id @default(uuid())
  owner       Owner          @relation(fields: [ownerId], references: [id])
  ownerId     String
  project     StudioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  visibility  VisibilityType
  url         String
  duration    Float
  bytes       Int
  bpm         Int?
  key         Key?
  mode        Mode?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  likes       TrackLike[]
}

model TrackLike {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId   String
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
}

model Session {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model StudioProject {
  id         String         @id @unique
  state      Bytes
  samples    Sample[]
  owner      Owner          @relation(fields: [ownerId], references: [id])
  ownerId    String
  name       String
  duration   Int
  bpm        Int
  visibility VisibilityType
  key        Key?
  mode       Mode?
  type       ProjectType    @default(PRODUCE)
  tracks     Track[]
  archived   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Conversation {
  id            String                    @id @default(uuid())
  pairKey       String                    @unique
  participants  ConversationParticipant[]
  lastMessageAt DateTime
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model ConversationParticipant {
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId   String
  messagesReceived Message[]    @relation("MessageReceiver")
  messagesSent     Message[]    @relation("MessageSender")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  unreadCount      Int          @default(0)
  lastReadAt       DateTime?

  @@id([conversationId, userId])
}

model Message {
  id             String                  @id @default(uuid())
  content        String
  author         ConversationParticipant @relation("MessageSender", fields: [conversationId, authorId], references: [conversationId, userId], onDelete: Cascade)
  authorId       String
  to             ConversationParticipant @relation("MessageReceiver", fields: [conversationId, toId], references: [conversationId, userId], onDelete: Cascade)
  toId           String
  conversationId String
  createdAt      DateTime                @default(now())
}
