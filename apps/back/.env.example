POSTGRES_URL=postgresql://username:password@localhost:5432/transcendence_dev?schema=public
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=transcendence_dev
JWT_SECRET=choose_some_strong_secret
# Relative to apps/back (pnpm --filter @transcendence/back). Must hit repo infra/media_data
# (the folder nginx-media mounts), not apps/back/infra/…
MEDIA_ROOT=../../infra/media_data
