{
  "name": "transcendence",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check": "prettier --check . && pnpm -r --no-bail run check && pnpm run typecheck",
    "fix": "prettier --write . && pnpm -r --no-bail run fix && pnpm run typecheck",
    "services:up": "docker compose up -d",
    "services:down": "docker compose --profile prod down",
    "services:logs": "docker compose logs -f",
    "services:kill": "docker compose --profile prod down -v --remove-orphans",
    "prod": "docker compose -f docker-compose.yaml --profile prod up -d --build",
    "typecheck": "pnpm -r --no-bail run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "private": "true",
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "3.8.3",
    "typescript": "6.0.2"
  }
}
