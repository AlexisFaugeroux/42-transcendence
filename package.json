{
  "name": "transcendence",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check": "prettier --check . && eslint .",
    "fix": "prettier --write . && ESLINT_SORT=on eslint --fix .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose --profile prod down",
    "services:logs": "docker compose logs -f",
    "services:kill": "docker compose --profile prod down -v --remove-orphans",
    "prod": "sh scripts/gen-certs.sh && docker compose -f docker-compose.yaml --profile prod up -d --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "private": "true",
  "devDependencies": {
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "6.0.2"
  }
}
