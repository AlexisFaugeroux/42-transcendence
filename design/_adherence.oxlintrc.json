{
  "plugins": ["react", "import"],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "auth-shell.jsx",
              "components/**",
              "dashboard.jsx",
              "data.js",
              "design-canvas.jsx",
              "home-variant-a.jsx",
              "icons.jsx",
              "landing.jsx",
              "login.jsx",
              "primitives.jsx",
              "profile.jsx",
              "samples.jsx",
              "sessions.jsx",
              "signup.jsx",
              "studio-icons.jsx",
              "studio.jsx",
              "ui_kits/studio/**",
              "users.jsx"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Rubik|Open Sans))/i]",
        "message": "Font not provided by the design system. Available: Rubik, Open Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|status|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, status, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:live|online|idle|offline)$/]",
        "message": "<Avatar> status must be one of 'live' | 'online' | 'idle' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|size|active|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, color, size, active, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:framed|solid)$/]",
        "message": "<Button> variant must be one of 'framed' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KnobDesign'] > JSXAttribute > JSXIdentifier[name!=/^(?:radius|trackWidth|angleOffset|indicator|indicatorWidth|key|ref|className|style|children)$/]",
        "message": "<KnobDesign> doesn't accept that prop. Declared props: radius, trackWidth, angleOffset, indicator, indicatorWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeakMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:l|r|width|key|ref|className|style|children)$/]",
        "message": "<PeakMeter> doesn't accept that prop. Declared props: l, r, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dot|active|color|title|onClick|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: label, dot, active, color, title, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:seed|width|height|color|bg|progress|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: seed, width, height, color, bg, progress."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|accent|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color, accent."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/index.js"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Avatar": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "Icon": {
        "replaces": []
      },
      "KnobDesign": {
